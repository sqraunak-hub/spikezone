# Copy this file to .env and fill in real values. Never commit .env.

# ---- Django core ----
# Generate a new key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
# Comma-separated, e.g. birdspikes.in,www.birdspikes.in (leave empty for local dev)
DJANGO_ALLOWED_HOSTS=

# ---- Database ----
# Leave unset for MySQL (production). Set to 'sqlite' for local development
# without a MySQL server; the file lands at spikezoneapi/db.sqlite3.
DB_ENGINE=
DB_NAME=spikezoneapi
DB_USER=root
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=3306

# ---- Razorpay ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=change-me

# ---- Email (SMTP) ----
# Leave unset for real SMTP. Set to
# django.core.mail.backends.console.EmailBackend locally to print OTP mails to
# the runserver console instead of sending them.
EMAIL_BACKEND=
EMAIL_HOST=spikezone.in
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=otp@spikezone.in
EMAIL_HOST_PASSWORD=change-me

# ---- Phone OTP login ----
# Which provider the /phone/* endpoints use. Only 'firebase' is registered.
OTP_PROVIDER=firebase
# Path to the Firebase service-account JSON (Project Settings > Service
# accounts > Generate new private key). Keep this file OUTSIDE the web root -
# it grants admin access to the Firebase project.
FIREBASE_CREDENTIALS_FILE=/home/USER/secrets/spikezone-firebase-adminsdk.json
# Alternative to the file, for hosts that only give you env vars: paste the
# whole JSON on one line. Leave empty when using FIREBASE_CREDENTIALS_FILE.
FIREBASE_CREDENTIALS_JSON=
