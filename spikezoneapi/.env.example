# Copy this file to .env and fill in real values. Never commit .env.

# ---- Django core ----
# Generate a new key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
# Comma-separated, e.g. birdspikes.in,www.birdspikes.in (leave empty for local dev)
DJANGO_ALLOWED_HOSTS=

# ---- Database (MySQL) ----
DB_NAME=spikezoneapi
DB_USER=root
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=3306

# ---- Razorpay ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=change-me

# ---- Email (SMTP) ----
EMAIL_HOST=spikezone.in
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=otp@spikezone.in
EMAIL_HOST_PASSWORD=change-me
