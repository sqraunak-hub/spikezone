# Template for the API's production .env. Copy to .env ON THE SERVER and fill
# in the marked values. Never commit the filled-in file.
#
#   cp .env.production.template .env && nano .env
#
# Everything marked FILL-IN has to come from the hosting panel or from whoever
# holds the credentials - none of it is in the repo.

# ---- Django core ----
# Generate a fresh one for production, do not reuse the local key:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=FILL-IN
# Must be False in production. With DEBUG=True Django serves full tracebacks -
# including settings and environment - to anyone who triggers an error.
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.spikezone.in,spikezone.in,www.spikezone.in
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.spikezone.in,https://spikezone.in,https://www.spikezone.in,https://admin.spikezone.in

# ---- Database (MySQL) ----
# Leave DB_ENGINE unset: that selects MySQL. 'sqlite' is a local-dev-only
# escape hatch and must never be set here.
DB_NAME=FILL-IN
DB_USER=FILL-IN
DB_PASSWORD=FILL-IN
DB_HOST=localhost
DB_PORT=3306

# ---- Razorpay ----
# Live keys, not rzp_test_*. Checkout stays broken until these are real.
RAZORPAY_KEY_ID=FILL-IN
RAZORPAY_KEY_SECRET=FILL-IN

# ---- Email (SMTP) ----
# Powers the email-OTP login as well as order mail, so a wrong password here
# takes out the free login path too. Leave EMAIL_BACKEND unset for real SMTP.
EMAIL_BACKEND=
EMAIL_HOST=spikezone.in
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=otp@spikezone.in
EMAIL_HOST_PASSWORD=FILL-IN

# ---- Phone OTP login (Firebase project: spikezone-re) ----
OTP_PROVIDER=firebase
# Absolute path to the service-account JSON. Put it OUTSIDE public_html - it
# grants admin access to the Firebase project, and anything under the web root
# can be fetched over HTTP.
#   e.g. /home/<cpanel-user>/secrets/spikezone-re-firebase-adminsdk.json
#   chmod 600 that file.
FIREBASE_CREDENTIALS_FILE=FILL-IN
# Alternative if the host only offers env vars: paste the whole JSON on one
# line here and leave FIREBASE_CREDENTIALS_FILE empty.
FIREBASE_CREDENTIALS_JSON=
