# Copy this file to .env and adjust for your environment.

# Django API host (no trailing slash). Production: https://api.spikezone.in
VITE_API_HOST=http://127.0.0.1:8001

# Public origin of the storefront (no trailing slash) — used for canonical/OG URLs.
VITE_SITE_URL=http://localhost:5175

# ---- Firebase (mobile OTP login) ----
# All public values - they ship inside the JS bundle. The real protection is
# the SMS region policy (India only) + authorized domains in the Firebase
# console. Leave blank to hide the "Mobile OTP" tab and run email-only login.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
